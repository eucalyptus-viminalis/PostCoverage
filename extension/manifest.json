{
  "manifest_version": 3,
  "name": "PostCoverage",
  "version": "0.1.0",
  "description": "Checks your Farcaster post against the Network Code while you write it.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://farcaster.xyz/*",
    "https://api.anthropic.com/*",
    "https://api.openai.com/*",
    "https://openrouter.ai/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "PostCoverage settings", "default_icon": { "16": "icons/16.png", "48": "icons/48.png" } },
  "options_ui": { "page": "options.html", "open_in_tab": false },
  "content_scripts": [
    {
      "matches": ["https://farcaster.xyz/*"],
      "js": ["network-code.js", "engine.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
